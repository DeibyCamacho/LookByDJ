# Copiar a .env (este archivo SÍ se sube; .env NO se sube)
# Desarrollo: DJANGO_DEBUG=1 y una clave cualquiera local.
# Producción: DJANGO_DEBUG=0, DJANGO_SECRET_KEY de >=50 caracteres aleatorios,
# DJANGO_ALLOWED_HOSTS con los dominios reales y SMTP configurado.
DJANGO_SECRET_KEY=cambia-esta-clave-en-clase
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lookby
DB_USER=lookby
DB_PASSWORD=lookby123
DB_HOST=localhost
DB_PORT=5432

# Solo producción (con DJANGO_DEBUG=0):
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=clave
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=LookBy <no-reply@tu-dominio.com>
